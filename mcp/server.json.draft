{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.okle42/cool42",
  "title": "cool42 — Apple Silicon thermal gate",
  "description": "Apple Silicon thermal gate for AI agents: check macOS thermal pressure, wait for cool-down, set fan mode.",
  "version": "1.0.3",
  "websiteUrl": "https://github.com/Okle42/cool42/blob/main/README.en.md",
  "repository": {
    "url": "https://github.com/Okle42/cool42",
    "source": "github",
    "id": "1375333550",
    "subfolder": "mcp"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "cool42-mcp",
      "version": "1.0.3",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "COOL42_BIN",
          "description": "Path to the cool42 CLI installed by install.sh. The cool42 guard LaunchDaemon (root) must be running; macOS on Apple Silicon only.",
          "format": "filepath",
          "isRequired": false,
          "default": "/usr/local/bin/cool42"
        }
      ]
    }
  ]
}
